          "raw": "{\n  \"user_id\": 6,\n  \"nombres\": \"Luis Alberto\",\n  \"apellidos\": \"Martinez Lopez\",\n  \"distrito\": \"San Isidro\",\n  \"telefono\": \"912345678\",\n  \"especie_preferida\": \"Perro\",\n  \"tamano_preferido\": \"Mediano\",\n  \"edad_preferida\": \"Adulto\"\n}"
        },
        "url": {
          "raw": "http://localhost/adopciones_api/users/updateUser.php",
