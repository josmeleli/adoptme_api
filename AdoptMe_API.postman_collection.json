      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "http://localhost/adopciones_api/pets/getPets.php?page=2&limit=6",
          "protocol": "http",
          "host": ["localhost"],
          "path": ["adopciones_api", "pets", "getPets.php"],
