    {
      "name": "12. SPRINT 2 - Catálogo de Mascotas (todas)",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "http://localhost/adopciones_api/pets/getPets.php",
          "protocol": "http",
          "host": ["localhost"],
          "path": ["adopciones_api", "pets", "getPets.php"]
        },
        "description": "HU-004 CA-001: Muestra todas las mascotas disponibles con foto, especie, edad y ubicación.\nCA-002: Mascotas urgentes aparecen primero.\nCA-003: Paginación con mínimo 6 resultados por página."
      }
    },
    {
      "name": "13. SPRINT 2 - Filtrar por Especie",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "http://localhost/adopciones_api/pets/getPets.php?especie=Perro",
          "protocol": "http",
          "host": ["localhost"],
          "path": ["adopciones_api", "pets", "getPets.php"],
          "query": [
            {
              "key": "especie",
              "value": "Perro",
              "description": "Valores: Perro, Gato"
            }
          ]
        },
        "description": "TR-06: Filtro por especie de mascota"
      }
    },
    {
      "name": "14. SPRINT 2 - Filtros Combinados",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "http://localhost/adopciones_api/pets/getPets.php?especie=Gato&tamano=Pequeño&categoria_edad=cachorro",
          "protocol": "http",
          "host": ["localhost"],
          "path": ["adopciones_api", "pets", "getPets.php"],
          "query": [
            {
              "key": "especie",
              "value": "Gato"
            },
            {
              "key": "tamano",
              "value": "Pequeño",
              "description": "Valores: Pequeño, Mediano, Grande"
            },
            {
              "key": "categoria_edad",
              "value": "cachorro",
              "description": "Valores: cachorro (0-2), adulto (3-7), senior (8+)"
            }
          ]
        },
        "description": "TR-06: Múltiples filtros combinados"
      }
    },
